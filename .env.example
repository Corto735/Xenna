# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS commiter .env — seul .env.example va dans git

# ── Serveur web (mode standalone Axum) ───────────────────────────────────────
PORT=8080
DATABASE_PATH=./xenna.db
DIST_DIR=../dist

# ── Auth admin ───────────────────────────────────────────────────────────────
# ADMIN_JWT_SECRET=générer_avec: openssl rand -hex 32

# ── Auth membres La Forge (/la_forge) ─────────────────────────────────────────
# MEMBER_JWT_SECRET=générer_avec: openssl rand -hex 32

# ── Chiffrement des données personnelles (emails) ─────────────────────────────
# ENCRYPTION_KEY=générer_avec: openssl rand -base64 32

# ── Altcha CAPTCHA (anti-bot open source) ────────────────────────────────────
# ALTCHA_SECRET=générer_avec: openssl rand -hex 16

# ── SMTP — email de vérification d'inscription ───────────────────────────────
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=ton@email.com
# SMTP_PASS=ta_cle_api_smtp
# SMTP_FROM=noreply@payetonbulletin.fr
# BASE_URL=https://payetonbulletin.fr

# ── PostgreSQL (SaaS uniquement — repo privé) ────────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/xenna_saas
